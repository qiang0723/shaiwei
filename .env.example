# 复制为 .env（已被 gitignore），填入真实值
TUSHARE_TOKEN=
SHAIWEI_DATA_ROOT=./data
SHAIWEI_ENV=dev   # dev | prod
FEISHU_ALERTS_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
FEISHU_TIMEOUT_SECONDS=10
FEISHU_MAX_ATTEMPTS=3
FEISHU_RETRY_BASE_SECONDS=1.0
FEISHU_HEARTBEAT_SECONDS=1800
# 国内行情/财务接口保持直连。Compose 会强制覆盖为同一组脱敏域名。
NO_PROXY=api.waditu.com,.waditu.com,.sina.com.cn,.eastmoney.com,.baostock.com,localhost,127.0.0.1
no_proxy=api.waditu.com,.waditu.com,.sina.com.cn,.eastmoney.com,.baostock.com,localhost,127.0.0.1
