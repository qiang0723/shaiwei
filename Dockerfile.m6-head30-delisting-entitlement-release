FROM shaiwei:m6-head30-500k-entrypoint-recovery-v1

ARG SHAIWEI_COMPONENT_GIT_COMMIT=""
ARG SHAIWEI_COMPONENT_BUILD_SNAPSHOT_SHA256=""
ARG SHAIWEI_SOURCE_BUNDLE_SHA256=""

LABEL org.opencontainers.image.revision="${SHAIWEI_COMPONENT_GIT_COMMIT}" \
      io.shaiwei.component_build_snapshot_sha256="${SHAIWEI_COMPONENT_BUILD_SNAPSHOT_SHA256}" \
      io.shaiwei.source_bundle_sha256="${SHAIWEI_SOURCE_BUNDLE_SHA256}"

COPY src ./src
COPY config ./config
COPY docs/ADR_002_FROZEN_COMPONENT_REGISTRY_AUTHORITY_20260823.md ./docs/ADR_002_FROZEN_COMPONENT_REGISTRY_AUTHORITY_20260823.md
COPY docs/M6_CSI800_PRODUCTION_HEAD30_STOCK_DIVIDEND_ENTITLEMENT_RECOVERY_ACCEPTANCE_20260823.md ./docs/M6_CSI800_PRODUCTION_HEAD30_STOCK_DIVIDEND_ENTITLEMENT_RECOVERY_ACCEPTANCE_20260823.md
COPY docs/M6_CSI800_PRODUCTION_HEAD30_DELISTING_ENTITLEMENT_RELEASE_PROTOCOL_20260823.md ./docs/M6_CSI800_PRODUCTION_HEAD30_DELISTING_ENTITLEMENT_RELEASE_PROTOCOL_20260823.md
COPY .web-release/m6-head30-delisting-entitlement-source-manifest.json /opt/shaiwei/component-source-manifest.json

ENV SHAIWEI_COMPONENT_GIT_COMMIT=${SHAIWEI_COMPONENT_GIT_COMMIT} \
    SHAIWEI_COMPONENT_SOURCE_MANIFEST=/opt/shaiwei/component-source-manifest.json

CMD ["python", "-m", "shaiwei.research.capital_feasibility.entitlement_release.fixture", "--help"]
