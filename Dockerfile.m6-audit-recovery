FROM shaiwei:m6-model-attribution-release-v1

ARG SHAIWEI_M6_AUDIT_RECOVERY_GIT_HEAD=""
ENV SHAIWEI_M6_AUDIT_RECOVERY_GIT_HEAD=${SHAIWEI_M6_AUDIT_RECOVERY_GIT_HEAD}

RUN mkdir -p /opt/shaiwei/m6-audit-recovery
COPY --chmod=0444 src/shaiwei/research/model_attribution/audit_recovery_contract.py /opt/shaiwei/m6-audit-recovery/audit_recovery_contract.py
COPY --chmod=0444 src/shaiwei/research/model_attribution/audit_recovery_entrypoint.py /opt/shaiwei/m6-audit-recovery/entrypoint.py

CMD ["python", "/opt/shaiwei/m6-audit-recovery/entrypoint.py", "--self-test"]
