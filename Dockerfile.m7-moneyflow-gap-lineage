FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/shaiwei/src

WORKDIR /opt/shaiwei

COPY requirements.m5-data-gate.lock ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install --no-deps -r requirements.m5-data-gate.lock

COPY src/shaiwei/__init__.py ./src/shaiwei/__init__.py
COPY src/shaiwei/research_gates/m7_moneyflow ./src/shaiwei/research_gates/m7_moneyflow
COPY src/shaiwei/research_gates/m7_moneyflow_lineage ./src/shaiwei/research_gates/m7_moneyflow_lineage
COPY config/m7_moneyflow_gap_lineage_v1.yaml ./config/
COPY config/m7_moneyflow_gap_lineage_input_manifest_v1.json ./config/
COPY config/m7_star_custom_pool_moneyflow_data_v1.yaml ./config/
COPY config/m7_star_custom_pool_moneyflow_data_gate_build_v1.yaml ./config/
COPY config/m7_star_custom_pool_moneyflow_protocol_scope_v1.json ./config/
COPY config/m7_star_custom_pool_moneyflow_proposal_export_v1.json ./config/
COPY config/m3_star_custom_pit_v1.yaml ./config/
COPY config/m3_star_custom_pit_manifest_v1.json ./config/
COPY config/m7_moneyflow_recovery_engineering_v1.yaml ./config/
COPY docs/M7_MONEYFLOW_GAP_LINEAGE_PROTOCOL_20260809.md ./docs/
COPY docs/M7_MONEYFLOW_RECOVERY_ENGINEERING_ACCEPTANCE_20260808.md ./docs/
COPY docs/M7_STAR_CUSTOM_POOL_MONEYFLOW_DATA_COMPATIBILITY_PROTOCOL_20260808.md ./docs/
COPY docs/M7_STAR_CUSTOM_POOL_MONEYFLOW_PROTOCOL_FREEZE_ACCEPTANCE_20260808.md ./docs/

RUN groupadd --gid 65532 lineage \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin lineage \
    && python -m compileall -q src

USER 65532:65532

CMD ["python", "-m", "shaiwei.research_gates.m7_moneyflow_lineage.fixture", "--project-root", "/opt/shaiwei"]
