FROM shaiwei:ts-v4-density-preflight@sha256:949a2c26c284bf3c083df317055519f4bd0a519ec2cb5224c0dfa12ec94a9016

ARG SHAIWEI_RELEASE_GIT_HEAD=""
ENV SHAIWEI_RELEASE_GIT_HEAD=${SHAIWEI_RELEASE_GIT_HEAD}
ENV SHAIWEI_RELEASE_MANIFEST=/opt/shaiwei/release-manifest.json

USER 0:0
COPY Dockerfile.ts-v5-r3g1 compose.ts-v5-r3g1.yaml ./
COPY src ./src
COPY config ./config
RUN python -m shaiwei.provenance --write-release-manifest /opt/shaiwei/release-manifest.json
USER 10001:10001

CMD ["python", "-m", "shaiwei.research.trend_swing.v5_r3g1_cli", "profile"]
