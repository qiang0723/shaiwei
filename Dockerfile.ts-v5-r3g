FROM shaiwei:ts-v5-r3f-canary-001@sha256:f3ccf7dfde00da698f2eae2172dcabad33fbe65346c31b45611402959c056efd

ARG SHAIWEI_RELEASE_GIT_HEAD=""

ENV SHAIWEI_RELEASE_GIT_HEAD=${SHAIWEI_RELEASE_GIT_HEAD}

USER 0:0

COPY Dockerfile.ts-v5-r3g compose.ts-v5-r3g.yaml ./
COPY src ./src
COPY config ./config

RUN python -m shaiwei.provenance \
    --write-release-manifest /opt/shaiwei/release-manifest.json

USER 10001:10001

CMD ["python", "-m", "shaiwei.research.trend_swing.v5_r3g_acceptance"]
