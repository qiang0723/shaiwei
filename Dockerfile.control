FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/workspace/src

WORKDIR /workspace

COPY requirements.web.lock pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install --no-deps -r requirements.web.lock

COPY src ./src
RUN groupadd --gid 10001 control \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin control \
    && mkdir -p /workspace/config /workspace/docs \
       /workspace/data/web/research_snapshots/strategy_factory_v2/snapshots \
       /workspace/data/control/m5 \
    && chown -R 10001:10001 /workspace/data/control/m5

USER 10001:10001

CMD ["uvicorn", "shaiwei.research_control.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
